# Copia este archivo a ".env" y pega tus valores reales ahí.
# Este archivo (.env.example) sí se sube a git -- nunca tiene valores
# reales, solo la lista de variables que Enlaza necesita y de dónde
# sacar cada una. El .env real (con tus valores) está en .gitignore y
# nunca debe subirse.

# Clave gratuita de IA — consíguela en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Puerto donde corre el servidor en local (Render asigna el suyo solo,
# esta variable es solo para cuando corres `npm start` en tu computador).
PORT=3000

# Cadena de conexión a la base de datos PostgreSQL (gratis, sin expirar).
# 1. Crea una cuenta en https://supabase.com (gratis, no pide tarjeta)
# 2. Crea un proyecto nuevo
# 3. Ve a Project Settings -> Database -> Connection string -> modo "Transaction pooler"
# 4. Copia esa cadena aquí, reemplazando [YOUR-PASSWORD] por tu contraseña real
DATABASE_URL=

# Client ID de Google (OAuth) -- lo genera Google Cloud Console, en
# "Credenciales" -> "ID de cliente de OAuth 2.0". No es secreto (el
# navegador lo necesita para mostrar el botón de login), pero igual vive
# en variables de entorno para no tenerlo pegado a mano en el HTML.
GOOGLE_CLIENT_ID=

# Cualquier cadena larga y aleatoria -- firma las cookies de sesión.
# Generar una nueva: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcional. Orígenes EXTRA (separados por coma) a los que se les permite
# leer respuestas de la API de Enlaza desde el navegador -- ej. si algún
# día existe una app aparte en otro dominio que necesite llamar esta API.
# Vacío por defecto: el propio frontend de Enlaza nunca necesita estar
# en esta lista (mismo origen). Ver seguridad.js.
ALLOWED_ORIGINS=
